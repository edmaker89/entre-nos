# Gere senhas alfanuméricas aleatórias; caracteres especiais exigem codificação nas URLs.
POSTGRES_PASSWORD=replace_with_random_owner_password
APP_DB_PASSWORD=replace_with_random_runtime_password
APP_HOST=financas.example.com
APP_ORIGIN=https://financas.example.com
SECURE_COOKIES=true
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_TAG=local
EMAIL_TIMEOUT_SECONDS=5
AUTH_RATE_LIMIT_SECRET=replace_with_a_separate_random_secret
